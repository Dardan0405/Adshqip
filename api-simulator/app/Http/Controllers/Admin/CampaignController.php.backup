            'conversions' => 0,
            'ctr'         => 0.00,
            'advertiser'  => $source['advertiser'] ?? 'admin@adshqip.com',
            'budget'      => $source['budget'] ?? 0.00,
            'spend'       => 0.00,
        ];

        array_unshift($existing, $duplicate);
        session(['created_campaigns' => $existing]);

        return redirect()->route('admin.campaigns')->with('success', 'Campaign "' . $source['name'] . '" has been duplicated as "' . $duplicate['name'] . '".');
    }

    /**
     * Move a campaign to a group.
     */
    public function moveToGroup(Request $request, int $id)
    {
        $request->validate([
            'group_id' => 'required|integer',
        ]);

        $groupId = (int) $request->input('group_id');

        // Resolve group name
        $demoGroups = [
            1 => 'Summer 2025',
            2 => 'Balkans — Brand Awareness',
            3 => 'Performance Q3',
            4 => 'Retargeting Pool',
            5 => 'App Install Campaigns',
        ];
        $sessionGroups = session('campaign_groups', []);
        $groupName = $demoGroups[$groupId] ?? null;
        if (!$groupName) {
            foreach ($sessionGroups as $g) {
                if ($g['id'] === $groupId) {
                    $groupName = $g['name'];
                    break;
                }
            }
        }
        $groupName = $groupName ?? 'Group #' . $groupId;

        // Store group assignment in session
        $assignments = session('campaign_group_assignments', []);
        $assignments[$id] = $groupId;
        session(['campaign_group_assignments' => $assignments]);

        // Also update session-created campaigns if applicable
        $sessionCampaigns = session('created_campaigns', []);
        foreach ($sessionCampaigns as &$c) {
            if ($c['id'] === $id) {
                $c['group_id'] = $groupId;
                break;
            }
        }
        unset($c);
        session(['created_campaigns' => $sessionCampaigns]);

        return redirect()->route('admin.campaigns', [
            'status' => $request->query('status', 'all'),
            'search' => $request->query('search', ''),
            'page' => $request->query('page', 1),
        ])->with('success', 'Campaign #' . $id . ' has been moved to "' . $groupName . '".');
    }

