        $sessionCampaigns = session('created_campaigns', []);
        $allCampaigns = array_merge($sessionCampaigns, $demoCampaigns);

        // Apply session-stored status overrides
        $statusOverrides = session('campaign_status_overrides', []);
        foreach ($allCampaigns as &$c) {
            if (isset($statusOverrides[$c['id']])) {
                $c['status'] = $statusOverrides[$c['id']];
            }
        }
        unset($c);

        // Apply session-stored campaign edits
        $edits = session('campaign_edits', []);
        foreach ($allCampaigns as &$c) {
            if (isset($edits[$c['id']])) {
                $c = array_merge($c, $edits[$c['id']]);
            }
        }
        unset($c);

        // Remove deleted campaigns
        $deletedIds = session('deleted_campaign_ids', []);
        $allCampaigns = array_filter($allCampaigns, fn($c) => !in_array($c['id'], $deletedIds));
        $allCampaigns = array_values($allCampaigns);

        // Compute stats from actual data
        $stats = [
            'total'          => count($allCampaigns),
            'active'         => count(array_filter($allCampaigns, fn($c) => $c['status'] === 'active')),
            'paused'         => count(array_filter($allCampaigns, fn($c) => $c['status'] === 'paused')),
            'draft'          => count(array_filter($allCampaigns, fn($c) => $c['status'] === 'draft')),
            'completed'      => count(array_filter($allCampaigns, fn($c) => $c['status'] === 'completed')),
            'rejected'       => count(array_filter($allCampaigns, fn($c) => $c['status'] === 'rejected')),
            'pending_review' => count(array_filter($allCampaigns, fn($c) => $c['status'] === 'pending_review')),
            'total_budget'   => array_sum(array_column($allCampaigns, 'budget')),
            'total_spend'    => array_sum(array_column($allCampaigns, 'spend')),
        ];

        // Apply status filter
        $statusFilter = $request->query('status', 'all');
        if ($statusFilter !== 'all') {
            $allCampaigns = array_filter($allCampaigns, fn($c) => $c['status'] === $statusFilter);
            $allCampaigns = array_values($allCampaigns);
        }

        // Apply search filter
        $search = $request->query('search', '');
        if ($search) {
            $allCampaigns = array_filter($allCampaigns, fn($c) =>
                stripos($c['name'], $search) !== false ||
                stripos($c['advertiser'], $search) !== false ||
                stripos((string)$c['id'], $search) !== false
            );
            $allCampaigns = array_values($allCampaigns);
        }

        // Pagination
        $perPage = 10;
        $page = max(1, (int) $request->query('page', 1));
        $totalFiltered = count($allCampaigns);
        $totalPages = (int) ceil($totalFiltered / $perPage);
        $page = min($page, max($totalPages, 1));
        $offset = ($page - 1) * $perPage;
        $campaigns = array_slice($allCampaigns, $offset, $perPage);

        $pagination = [
            'current_page' => $page,
            'per_page'     => $perPage,
            'total'        => $totalFiltered,
            'total_pages'  => $totalPages,
            'from'         => $totalFiltered > 0 ? $offset + 1 : 0,
            'to'           => min($offset + $perPage, $totalFiltered),
        ];

        // Campaign groups (demo + session)
        $campaignGroups = [
            ['id' => 1, 'name' => 'Summer 2025'],
            ['id' => 2, 'name' => 'Balkans — Brand Awareness'],
            ['id' => 3, 'name' => 'Performance Q3'],
            ['id' => 4, 'name' => 'Retargeting Pool'],
            ['id' => 5, 'name' => 'App Install Campaigns'],
        ];
        $sessionGroups = session('campaign_groups', []);
        $campaignGroups = array_merge($campaignGroups, $sessionGroups);

        return view('admin.campaigns.index', compact('stats', 'campaigns', 'statusFilter', 'search', 'pagination', 'campaignGroups'));
    }

