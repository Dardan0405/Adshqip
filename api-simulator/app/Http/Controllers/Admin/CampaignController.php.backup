        $newId = count($allIds) > 0 ? max($allIds) + 1 : 2001;

        $duplicate = [
            'id'          => $newId,
            'name'        => ($source['name'] ?? 'Campaign') . ' (Copy)',
            'status'      => 'draft',
            'type'        => $source['type'] ?? 'cpm',
