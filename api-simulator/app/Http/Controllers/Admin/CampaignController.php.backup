        ];

        $sessionCampaigns = session('created_campaigns', []);
        $allCampaigns = array_merge($sessionCampaigns, $demoCampaigns);

        $statusOverrides = session('campaign_status_overrides', []);
        foreach ($allCampaigns as &$c) {
            if (isset($statusOverrides[$c['id']])) {
                $c['status'] = $statusOverrides[$c['id']];
            }
        }
        unset($c);

        $deletedIds = session('deleted_campaign_ids', []);
        $allCampaigns = array_filter($allCampaigns, fn($c) => !in_array($c['id'], $deletedIds));
        $allCampaigns = array_values($allCampaigns);

        // Apply status filter if provided
        $statusFilter = $request->query('status', 'all');
        if ($statusFilter !== 'all') {
            $allCampaigns = array_filter($allCampaigns, fn($c) => $c['status'] === $statusFilter);
            $allCampaigns = array_values($allCampaigns);
        }

        $headers = ['ID', 'Campaign Name', 'Status', 'Type', 'Model', 'Start Date', 'End Date', 'Advertiser', 'Impressions', 'Clicks', 'Conversions', 'CTR (%)', 'Budget', 'Spend'];

        if ($format === 'excel') {
            // Generate an HTML table that Excel can open natively
            $filename = 'campaigns_export_' . date('Y-m-d_His') . '.xls';
            return response()->streamDownload(function () use ($headers, $allCampaigns) {
                echo '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">';
                echo '<head><meta charset="UTF-8"><style>td,th{border:1px solid #ccc;padding:5px;font-family:Arial,sans-serif;font-size:12px;} th{background:#4f46e5;color:#fff;font-weight:bold;}</style></head><body>';
                echo '<table>';
                echo '<tr>';
                foreach ($headers as $h) {
                    echo '<th>' . htmlspecialchars($h) . '</th>';
                }
                echo '</tr>';
                foreach ($allCampaigns as $c) {
                    echo '<tr>';
                    echo '<td>' . $c['id'] . '</td>';
                    echo '<td>' . htmlspecialchars($c['name']) . '</td>';
                    echo '<td>' . ucwords(str_replace('_', ' ', $c['status'])) . '</td>';
                    echo '<td>' . strtoupper($c['type']) . '</td>';
                    echo '<td>' . $c['model'] . '</td>';
                    echo '<td>' . $c['start_date'] . '</td>';
                    echo '<td>' . ($c['end_date'] ?? '—') . '</td>';
                    echo '<td>' . htmlspecialchars($c['advertiser']) . '</td>';
                    echo '<td>' . number_format($c['impressions']) . '</td>';
                    echo '<td>' . number_format($c['clicks']) . '</td>';
                    echo '<td>' . number_format($c['conversions']) . '</td>';
                    echo '<td>' . number_format($c['ctr'], 2) . '%</td>';
                    echo '<td>€' . number_format($c['budget'], 2) . '</td>';
                    echo '<td>€' . number_format($c['spend'], 2) . '</td>';
                    echo '</tr>';
                }
                echo '</table></body></html>';
            }, $filename, [
                'Content-Type' => 'application/vnd.ms-excel',
                'Content-Disposition' => 'attachment; filename="' . $filename . '"',
            ]);
        }

        // Default: CSV
        $filename = 'campaigns_export_' . date('Y-m-d_His') . '.csv';
        return response()->streamDownload(function () use ($headers, $allCampaigns) {
            $output = fopen('php://output', 'w');
            // UTF-8 BOM for proper Excel encoding
            fprintf($output, chr(0xEF) . chr(0xBB) . chr(0xBF));
            fputcsv($output, $headers);
            foreach ($allCampaigns as $c) {
                fputcsv($output, [
                    $c['id'],
                    $c['name'],
                    ucwords(str_replace('_', ' ', $c['status'])),
                    strtoupper($c['type']),
                    $c['model'],
                    $c['start_date'],
                    $c['end_date'] ?? '—',
                    $c['advertiser'],
                    $c['impressions'],
                    $c['clicks'],
                    $c['conversions'],
                    number_format($c['ctr'], 2),
                    $c['budget'],
                    $c['spend'],
                ]);
            }
            fclose($output);
        }, $filename, [
            'Content-Type' => 'text/csv',
            'Content-Disposition' => 'attachment; filename="' . $filename . '"',
        ]);
    }

