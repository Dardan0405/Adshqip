            ['id' => 1029, 'name' => 'Gjakova Furniture — Click-to-Watch', 'status' => 'pending_review', 'type' => 'cpv_ctw', 'start_date' => '2025-09-01', 'end_date' => '2025-12-31', 'model' => 'CPV-CTW', 'impressions' => 0, 'clicks' => 0, 'conversions' => 0, 'ctr' => 0.00, 'advertiser' => 'furniture@gjakova.xk', 'budget' => 8000.00, 'spend' => 0.00],
            ['id' => 1030, 'name' => 'Berat Wine Tours — Seasonal CPM', 'status' => 'draft', 'type' => 'cpm', 'start_date' => '2025-10-01', 'end_date' => '2025-12-31', 'model' => 'CPM', 'impressions' => 0, 'clicks' => 0, 'conversions' => 0, 'ctr' => 0.00, 'advertiser' => 'winetours@berat.al', 'budget' => 3500.00, 'spend' => 0.00],
        ];

