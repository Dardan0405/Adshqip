                if ($c['id'] === $id) {
                    $source = $c;
                    break;
                }
            }
        }

        if (!$source) {
            return redirect()->route('admin.campaigns')->with('success', 'Campaign not found.');
        }

        // Generate new ID
        $existing = session('created_campaigns', []);
