                1030 => ['name' => 'Berat Wine Tours — Seasonal CPM', 'status' => 'draft', 'type' => 'cpm', 'start_date' => '2025-10-01', 'end_date' => '2025-12-31', 'model' => 'CPM', 'impressions' => 0, 'clicks' => 0, 'conversions' => 0, 'ctr' => 0.00, 'advertiser' => 'winetours@berat.al', 'budget' => 3500.00, 'spend' => 0.00],
            ];

            if (isset($basicDemos[$id])) {
                $campaign = array_merge(['id' => $id, 'description' => '', 'marketing_objective' => 'traffic', 'bid_amount' => 1.00, 'daily_budget' => 200.00, 'currency' => 'EUR', 'frequency_cap' => 5, 'targeting_geo' => [], 'targeting_device' => ['desktop', 'mobile'], 'weight' => 5], $basicDemos[$id]);
            } else {
                // Check session campaigns
                $campaign = null;
                $sessionCampaigns = session('created_campaigns', []);
                foreach ($sessionCampaigns as $c) {
                    if ($c['id'] === $id) {
                        $campaign = $c;
                        break;
                    }
                }
            }
        }

        if (!isset($campaign) || $campaign === null) {
            return null;
        }

        // Apply status overrides
        $statusOverrides = session('campaign_status_overrides', []);
        if (isset($statusOverrides[$id])) {
            $campaign['status'] = $statusOverrides[$id];
        }

        // Check if deleted
        $deletedIds = session('deleted_campaign_ids', []);
        if (in_array($id, $deletedIds)) {
            return null;
        }

        return $campaign;
    }

    /**
     * Show campaign details.
     */
    public function show(int $id)
    {
        $campaign = $this->findCampaign($id);
        if (!$campaign) {
            return redirect()->route('admin.campaigns')->with('success', 'Campaign not found.');
        }

        // Get group assignment
        $assignments = session('campaign_group_assignments', []);
        $groupName = null;
        if (isset($assignments[$id])) {
            $demoGroups = [1 => 'Summer 2025', 2 => 'Balkans — Brand Awareness', 3 => 'Performance Q3', 4 => 'Retargeting Pool', 5 => 'App Install Campaigns'];
            $groupName = $demoGroups[$assignments[$id]] ?? null;
            if (!$groupName) {
                foreach (session('campaign_groups', []) as $g) {
                    if ($g['id'] === $assignments[$id]) { $groupName = $g['name']; break; }
                }
            }
        }

        $campaign['group_name'] = $groupName;

        return view('admin.campaigns.show', compact('campaign'));
    }

    /**
     * Show the edit form for a campaign.
     */
    public function edit(int $id)
    {
        $campaign = $this->findCampaign($id);
        if (!$campaign) {
            return redirect()->route('admin.campaigns')->with('success', 'Campaign not found.');
        }

        // Campaign groups
        $campaignGroups = [
            ['id' => 1, 'name' => 'Summer 2025'],
            ['id' => 2, 'name' => 'Balkans — Brand Awareness'],
            ['id' => 3, 'name' => 'Performance Q3'],
            ['id' => 4, 'name' => 'Retargeting Pool'],
            ['id' => 5, 'name' => 'App Install Campaigns'],
        ];
        $sessionGroups = session('campaign_groups', []);
        $campaignGroups = array_merge($campaignGroups, $sessionGroups);

        // Get current group assignment
        $assignments = session('campaign_group_assignments', []);
        $campaign['group_id'] = $assignments[$id] ?? null;

        $campaignTypes = [
            'cpm' => 'CPM (Cost Per Mille)',
            'cpc' => 'CPC (Cost Per Click)',
            'cpa' => 'CPA (Cost Per Action)',
            'cpv' => 'CPV (Cost Per View)',
            'cpv_ctw' => 'CPV-CTW (Click-to-Watch)',
        ];

        $marketingObjectives = [
            'brand_awareness' => 'Brand Awareness',
            'reach' => 'Reach',
            'traffic' => 'Traffic',
            'engagement' => 'Engagement',
            'app_installs' => 'App Installs',
            'video_views' => 'Video Views',
            'lead_generation' => 'Lead Generation',
            'conversions' => 'Conversions',
            'catalog_sales' => 'Catalog Sales',
            'store_visits' => 'Store Visits',
        ];

        return view('admin.campaigns.edit', compact('campaign', 'campaignGroups', 'campaignTypes', 'marketingObjectives'));
    }

    /**
     * Update a campaign.
     */
    public function update(Request $request, int $id)
    {
        $typeMap = ['cpm' => 'CPM', 'cpc' => 'CPC', 'cpa' => 'CPA', 'cpv' => 'CPV', 'cpv_ctw' => 'CPV-CTW'];

        // Check if it's a session campaign
        $sessionCampaigns = session('created_campaigns', []);
        $found = false;
        foreach ($sessionCampaigns as &$c) {
            if ($c['id'] === $id) {
                $c['name'] = $request->input('name', $c['name']);
                $c['type'] = $request->input('campaign_type', $c['type']);
                $c['model'] = $typeMap[$c['type']] ?? strtoupper($c['type']);
                $c['status'] = $request->input('status', $c['status']);
                $c['start_date'] = $request->input('start_date', $c['start_date']);
                $c['end_date'] = $request->input('end_date', $c['end_date']);
                $c['budget'] = (float) $request->input('total_budget', $c['budget']);
                $c['description'] = $request->input('description', $c['description'] ?? '');
                $found = true;
                break;
            }
        }
        unset($c);

        if ($found) {
            session(['created_campaigns' => $sessionCampaigns]);
        } else {
            // For demo campaigns, store edits in session
            $edits = session('campaign_edits', []);
            $edits[$id] = [
                'name' => $request->input('name'),
                'type' => $request->input('campaign_type'),
                'model' => $typeMap[$request->input('campaign_type')] ?? strtoupper($request->input('campaign_type', '')),
                'status' => $request->input('status'),
                'start_date' => $request->input('start_date'),
                'end_date' => $request->input('end_date'),
                'budget' => (float) $request->input('total_budget', 0),
                'description' => $request->input('description', ''),
                'marketing_objective' => $request->input('marketing_objective', 'traffic'),
                'bid_amount' => (float) $request->input('bid_amount', 0),
                'daily_budget' => (float) $request->input('daily_budget', 0),
                'frequency_cap' => $request->input('frequency_cap'),
                'weight' => (int) $request->input('weight', 5),
            ];
            session(['campaign_edits' => $edits]);

            // Also store status override so index reflects the change
            $overrides = session('campaign_status_overrides', []);
            $overrides[$id] = $request->input('status');
            session(['campaign_status_overrides' => $overrides]);
        }

        // Update group assignment if provided
        $groupId = $request->input('campaign_group_id');
        if ($groupId) {
            $assignments = session('campaign_group_assignments', []);
            $assignments[$id] = (int) $groupId;
            session(['campaign_group_assignments' => $assignments]);
        }

        return redirect()->route('admin.campaigns.show', $id)->with('success', 'Campaign updated successfully!');
    }

    /**
     * Delete a campaign.
     */
    public function destroy(int $id)
    {
        // Add to deleted IDs in session
        $deletedIds = session('deleted_campaign_ids', []);
        if (!in_array($id, $deletedIds)) {
            $deletedIds[] = $id;
            session(['deleted_campaign_ids' => $deletedIds]);
        }

        // Also remove from session-created campaigns if applicable
        $sessionCampaigns = session('created_campaigns', []);
        $sessionCampaigns = array_filter($sessionCampaigns, fn($c) => $c['id'] !== $id);
        session(['created_campaigns' => array_values($sessionCampaigns)]);

        return redirect()->route('admin.campaigns')->with('success', 'Campaign #' . $id . ' has been deleted.');
    }
}
