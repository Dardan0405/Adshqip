                    'lider'       => 'Lider',
                    'native'      => 'Native',
                    'layer'       => 'Layer',
                    'catfish'     => 'Catfish',
                ],
            ],
            'display_video' => [
                'label' => 'Display Video',
                'sizes' => [
                    'inline_video'  => 'Inline Video',
                    'overlay_video' => 'Overlay Video',
                    'special_video' => 'Special Video',
                ],
            ],
        ];

        // Pricing models for country bidding
        $pricingModels = ['CPM', 'CPC', 'CPA', 'CPV'];

        return view('admin.campaigns.create', compact(
            'advertisers', 'campaignGroups', 'pixelTrackers', 'campaignTypes',
            'categories', 'trafficSources', 'countries', 'adFormats', 'pricingModels'
        ));
    }

    /**
     * Store a new campaign.
     */
    public function store(Request $request)
    {
        // Build a campaign entry from the form and persist in session (demo — no DB)
        $existing = session('created_campaigns', []);
        $newId = count($existing) > 0 ? max(array_column($existing, 'id')) + 1 : 2001;

        $typeMap = [
            'cpm' => 'CPM', 'cpc' => 'CPC', 'cpa' => 'CPA',
            'cpv' => 'CPV', 'cpv_ctw' => 'CPV-CTW',
        ];

        $status = $request->input('status', 'draft');
        $campaignType = $request->input('campaign_type', 'cpm');

        $startDate = $request->input('schedule_mode') === 'immediately'
            ? now()->format('Y-m-d')
            : ($request->input('start_date') ? \Carbon\Carbon::parse($request->input('start_date'))->format('Y-m-d') : now()->format('Y-m-d'));

        $endDate = $request->input('end_date')
            ? \Carbon\Carbon::parse($request->input('end_date'))->format('Y-m-d')
            : null;

        $campaign = [
            'id'          => $newId,
            'name'        => $request->input('name', 'Untitled Campaign'),
            'status'      => $status,
            'type'        => $campaignType,
            'start_date'  => $startDate,
            'end_date'    => $endDate,
            'model'       => $typeMap[$campaignType] ?? strtoupper($campaignType),
            'impressions' => 0,
            'clicks'      => 0,
            'conversions' => 0,
            'ctr'         => 0.00,
            'advertiser'  => 'admin@adshqip.com',
            'budget'      => 0.00,
            'spend'       => 0.00,
        ];

        array_unshift($existing, $campaign);
        session(['created_campaigns' => $existing]);

        return redirect()->route('admin.campaigns')->with('success', 'Campaign "' . $campaign['name'] . '" created successfully!');
    }

    /**
     * Create a new campaign group (AJAX endpoint).
     */
    public function storeGroup(Request $request)
    {
        $request->validate([
            'name' => 'required|string|max:255',
        ]);

        $name = $request->input('name');

        // Check for duplicates across demo + session groups
        $demoGroups = ['Summer 2025', 'Balkans — Brand Awareness', 'Performance Q3', 'Retargeting Pool', 'App Install Campaigns'];
        $sessionGroups = session('campaign_groups', []);
        $allNames = array_merge($demoGroups, array_column($sessionGroups, 'name'));

        if (in_array(strtolower($name), array_map('strtolower', $allNames))) {
            return response()->json([
                'success' => false,
                'message' => 'A campaign group with this name already exists.',
            ], 422);
        }

        // In production, save to database. For demo, store in session.
        $groups = $sessionGroups;
        $newId = count($groups) > 0 ? max(array_column($groups, 'id')) + 1 : 100;

        $group = [
            'id' => $newId,
            'name' => $name,
            'created_at' => now()->toDateTimeString(),
        ];

        $groups[] = $group;
        session(['campaign_groups' => $groups]);

        return response()->json([
            'success' => true,
            'message' => 'Campaign group created successfully.',
            'group' => $group,
        ]);
    }

    /**
     * Create a new pixel tracker (AJAX endpoint).
     */
    public function storePixel(Request $request)
    {
        $request->validate([
            'name' => 'required|string|max:255',
            'type' => 'required|string|in:javascript,image,server_to_server',
            'advertiser_id' => 'required',
        ]);

        $name = $request->input('name');

        // Check for duplicates across demo + session pixels
        $demoPixels = ['Main Website Pixel', 'Conversion Tracker', 'S2S Lead Pixel', 'App Events Pixel'];
        $sessionPixels = session('pixel_trackers', []);
        $allNames = array_merge($demoPixels, array_column($sessionPixels, 'name'));

        if (in_array(strtolower($name), array_map('strtolower', $allNames))) {
            return response()->json([
                'success' => false,
                'message' => 'A pixel tracker with this name already exists.',
            ], 422);
        }

        // In production, save to database. For demo, store in session.
        $pixels = $sessionPixels;
        $newId = count($pixels) > 0 ? max(array_column($pixels, 'id')) + 1 : 100;

        $pixel = [
            'id' => $newId,
            'name' => $name,
            'type' => $request->input('type'),
            'advertiser_id' => $request->input('advertiser_id'),
            'advertiser' => $request->input('advertiser_name', 'Unknown'),
            'category_id' => $request->input('category_id'),
            'protocol' => $request->input('protocol', 'https'),
            'goal_value' => $request->input('goal_value', 0),
            'status' => $request->input('status', 'active'),
            'code' => $request->input('code', ''),
            'created_at' => now()->toDateTimeString(),
        ];

        $pixels[] = $pixel;
        session(['pixel_trackers' => $pixels]);

        return response()->json([
            'success' => true,
            'message' => 'Pixel tracker created successfully.',
            'pixel' => $pixel,
        ]);
    }

    /**
     * Update campaign status (pause, resume, approve, reject).
     */
    public function updateStatus(Request $request, int $id)
    {
        $request->validate([
            'status' => 'required|string|in:active,paused,rejected,draft,completed,pending_review',
        ]);

        $newStatus = $request->input('status');

        // Store the status override in session
        $overrides = session('campaign_status_overrides', []);
        $overrides[$id] = $newStatus;
        session(['campaign_status_overrides' => $overrides]);

        // Also update session-created campaigns if applicable
        $sessionCampaigns = session('created_campaigns', []);
        foreach ($sessionCampaigns as &$c) {
            if ($c['id'] === $id) {
                $c['status'] = $newStatus;
                break;
            }
        }
        unset($c);
        session(['created_campaigns' => $sessionCampaigns]);

        $statusLabels = [
            'active' => 'activated',
            'paused' => 'paused',
            'rejected' => 'rejected',
            'draft' => 'moved to draft',
            'completed' => 'marked as completed',
            'pending_review' => 'set to pending review',
        ];

        return redirect()->route('admin.campaigns', [
            'status' => $request->query('status', 'all'),
            'search' => $request->query('search', ''),
            'page' => $request->query('page', 1),
        ])->with('success', 'Campaign #' . $id . ' has been ' . ($statusLabels[$newStatus] ?? 'updated') . '.');
    }

